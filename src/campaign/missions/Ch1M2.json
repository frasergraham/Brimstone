      "type": "gather_and_survive",
      "survivors": 2,
      "kills": 4,
      "phaseFallback": "dusk",
      "reason": "The survivors are safe — Caleb's Hollow holds out another night."
    },
    "lose": [
      {
        "type": "hero_killed"
      },
