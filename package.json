{
  "name": "calebs-hollow",
  "version": "1.3.17",
  "description": "Salem hex turn-based game with multiplayer",
  "main": "electron/main.js",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "DB_PATH=./data/brimstone.db node server.js",
    "dev:client": "npx serve . -p 3000",
    "test": "node --test tests/*.test.js",
    "test:verbose": "node --test --test-reporter=spec tests/*.test.js",
    "test:ui": "node --test tests/ui/*.test.js",
    "test:ui:verbose": "node --test --test-reporter=spec tests/ui/*.test.js",
    "test:all": "node --test tests/*.test.js tests/ui/*.test.js",
    "test:mp-net": "node scripts/headless-mp-net.js",
    "validate": "node scripts/validate.js",
    "release": "node scripts/release.js",
    "release:dry": "node scripts/release.js --dry-run",
    "assets:dry": "node scripts/generate-assets.js --dry-run",
    "assets:test": "node scripts/generate-assets.js --test",
    "assets:gen": "node scripts/generate-assets.js",
    "assets:stitch": "node scripts/generate-assets.js --stitch-only",
    "electron:dev": "electron . --env=dev",
    "electron:dev:prod": "electron . --env=prod",
    "electron:package": "electron-builder --publish never",
    "electron:package:mac": "electron-builder --mac --publish never",
    "electron:package:win": "electron-builder --win --publish never",
    "electron:build": "electron-builder",
    "electron:build:mac": "electron-builder --mac --config.directories.output=/tmp/brimstone-electron-dist",
    "electron:build:win": "electron-builder --win",
    "cap:copy-web": "node scripts/cap-copy-web.js",
    "cap:sync": "node scripts/cap-copy-web.js && npx cap sync",
    "cap:sync:ios": "node scripts/cap-copy-web.js && npx cap sync ios",
    "cap:sync:ios:local": "node scripts/cap-copy-web.js --env=local && npx cap sync ios",
    "cap:sync:ios:prod": "node scripts/cap-copy-web.js --env=prod && npx cap sync ios",
    "cap:sync:android": "node scripts/cap-copy-web.js && npx cap sync android",
    "cap:sync:android:prod": "node scripts/cap-copy-web.js --env=prod && npx cap sync android",
    "cap:open:ios": "npx cap open ios",
    "cap:open:android": "npx cap open android",
    "cap:run:ios": "node scripts/cap-copy-web.js && npx cap sync ios && node scripts/run-ios-sim.js",
    "cap:run:ios:prod": "node scripts/cap-copy-web.js --env=prod && npx cap sync ios && node scripts/run-ios-sim.js",
    "cap:run:android": "node scripts/cap-copy-web.js && npx cap run android"
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0",
    "sharp": "^0.33.5"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.80.0",
    "@capacitor/android": "^8.3.0",
    "@capacitor/app": "^8.1.0",
    "@capacitor/cli": "^8.3.0",
    "@capacitor/core": "^8.3.0",
    "@capacitor/ios": "^8.3.0",
    "@capacitor/preferences": "^8.0.1",
    "@capacitor/push-notifications": "^8.0.3",
    "@capacitor/splash-screen": "^8.0.1",
    "@capacitor/status-bar": "^8.0.2",
    "@parse/node-apn": "^6.5.0",
    "better-sqlite3": "^12.8.0",
    "canvas": "^3.2.3",
    "electron-store": "^10.0.0",
    "electron-updater": "^6.0.0",
    "express": "^5.2.1",
    "gif-encoder-2": "^1.0.5",
    "https-proxy-agent": "^8.0.0",
    "undici": "^7.24.6",
    "ws": "^8.20.0"
  }
}
