// Map generation pipeline — seeded, deterministic (src/map.js generateMap)
digraph map_gen {
  rankdir=TB; bgcolor="white";
  graph [fontname="Helvetica", fontsize=12, label=<<b>Map Generation Pipeline</b>  <font point-size="10">— seeded LCG, deterministic, independent of resolution</font>>, labelloc="t"];
  node [fontname="Helvetica", shape=box, style="rounded,filled", fillcolor="#eef2f7", color="#5b6b7d", fontsize=11, margin="0.18,0.10"];
  edge [fontname="Helvetica", color="#5b6b7d", penwidth=1.3, arrowsize=0.8];

  s1 [label="1 · Grass fill\nevery hex → GRASS"];
  s2 [label="2 · River\nN–S or E–W, one tile per row/col\n(3–4 from edges)", fillcolor="#dcecf5"];
  s3 [label="3 · Starts + buildings\nInn (hero) & Graveyard (witch) on\nopposite banks · villages · 2-hex footprints"];
  s4 [label="4 · Forest + dirt\ngrown from per-size seeds (before roads)", fillcolor="#e3efe1"];
  s5 [label="5 · Roads (MST)\nKruskal trunk over key points +\nriver crossings → bridges (invariant enforced)", fillcolor="#f3ecda"];
  s6 [label="6 · Blocked slots\nderived from final roads/forests/bridges"];
  s7 [label="7 · Power nodes\nN clusters of 3 hexes, ≥1 per bank,\n≥3 from starts, ≥4 apart", fillcolor="#efe6f2"];
  s8 [label="8 · (starts already placed in step 3)", fillcolor="#f7f7f7", color="#aaaaaa", fontcolor="#888888"];
  s9 [label="9 · Hidden survivors\nplaced by GameState (buildings then terrain)", fillcolor="#f5e8e8"];

  s1 -> s2 -> s3 -> s4 -> s5 -> s6 -> s7 -> s8 -> s9;
}
