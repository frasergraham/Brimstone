node_modules/
data/
*.db
*.db-shm
*.db-wal
.env
assets/generated/
.DS_Store

# FBX source + FBX2glTF intermediate (we ship the .glb output only)
assets/models/*.fbx
assets/models/*.fbm/
# Mixamo source FBX belongs in assets/source/animations/ — keep stray copies
# (e.g. from a Finder drag) out of the repo root.
/*.fbx
scripts/map-renders/
scripts/renders/
dist/
# build/ is electron-builder's buildResources dir. Keep the committed app icons;
# ignore any generated output that lands here (xcarchives/export now go to /tmp).
build/*
!build/icon.png
!build/icon.icns

# Character source FBX (Mixamo mesh+rig exports) — large (tens–hundreds of MB);
# only the converted, texture-stripped/-capped .glb under assets/models/ ships.
# Regenerate via: npm install --no-save fbx2gltf && node scripts/convert-character-fbx.js
assets/source/characters/*.fbx

# Capacitor build artifacts
www/
ios/App/Pods/
ios/capacitor-cordova-ios-plugins/
android/.gradle/
android/app/build/
android/capacitor-cordova-android-plugins/
.claude/*
!.claude/agents/
!.claude/commands/
!.claude/skills/
.claude/settings.local.json
.claude/worktrees/
specs/.supervisor-state.json
.auto-turn
.tmp/

# Teem orchestrator journal — per-worker event log, never committed
.teem-events/

# Raw 4K terrain source textures (AmbientCG/PolyHaven) — kept locally, not shipped.
# Only the prepared greyscale detail maps under terrain/ are tracked.
assets/textures/*
!assets/textures/terrain/
!assets/textures/terrain/**

# Editable source-art working files (e.g. Pixelmator .pxd) — kept locally. Only
# the exported runtime texture (e.g. assets/road-cobblestone.png) is tracked.
*.pxd
